{
  "name": "fitness-intellisense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @fi/api dev",
    "dev:mobile": "pnpm --filter @fi/mobile start",
    "build": "pnpm -r --filter \"./packages/*\" --filter @fi/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fi/api db:generate",
    "db:migrate": "pnpm --filter @fi/api db:migrate",
    "db:seed": "pnpm --filter @fi/api db:seed",
    "content:export": "pnpm --filter @fi/api content:export",
    "content:import": "pnpm --filter @fi/api content:import"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}

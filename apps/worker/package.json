{
  "name": "@fi/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --import tsx --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --use-system-ca --import tsx --env-file-if-exists=.env src/index.ts",
    "once": "node --use-system-ca --import tsx --env-file-if-exists=.env src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "@fi/domain": "workspace:*",
    "@fi/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.18.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

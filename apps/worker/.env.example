# The analysis worker's environment. Copy to .env and fill in.
#
# Every value except the two at the bottom is the same one the API uses, so the
# quickest way to fill this in is to copy them out of apps/api/.env — the
# worker reads the same database and the same bucket.
#
# NOT COMMITTED, and nothing here belongs in the repo: DATABASE_URL and the R2
# secret are credentials to production data.

# The database the API writes analyses to. The worker polls it for queued rows.
DATABASE_URL=

# Cloudflare R2 — where the uploaded clips are. The worker only ever reads.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The Python interpreter with the analyzer's PINNED dependencies — the venv
# created by `make setup` in services/analyzer, which by design lives outside
# the repo. Named explicitly rather than found on PATH: the analyzer pins numpy,
# opencv and scipy exactly, because a minor version bump moves keypoint values
# in the last decimal place and that is enough to flip a threshold.
#
#   Windows: C:/Users/<you>/.virtualenvs/ascension-analyzer/Scripts/python.exe
#   macOS/Linux: $HOME/.virtualenvs/ascension-analyzer/bin/python
ANALYZER_PYTHON=

# The analyzer package root — the directory containing src/analyzer.
ANALYZER_DIR=

# Optional. How long to wait after finding nothing to do (default 60000).
#
# Chosen against Neon's BILLING rather than against latency. The free tier
# suspends idle compute and charges for the hours it is awake, so a query every
# few seconds keeps it awake around the clock and spends the monthly allowance
# on finding nothing to do. A minute of queue latency is free in practice,
# because tracking a one-minute clip takes about two.
# POLL_INTERVAL_MS=60000

# Optional. Give up on one clip after this long (default 600000, ten minutes).
# Tracking a 60s clip takes about two minutes today.
# ANALYSIS_TIMEOUT_MS=600000

# Fitness Intellisense — API environment (BRD §14.2).
# Copy to .env for local development. Secrets are never committed (NFR-S-08).
# Every key here is also in the Zod schema in src/config.ts; the process
# refuses to boot if one is missing or malformed.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# NFR-D-05: the deployed commit, surfaced on /health. CI sets this.
COMMIT_SHA=local

# Neon: use the pooled connection string and keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fitness?sslmode=require
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_PEPPER=change-me-to-a-different-32-character-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# One-time codes for email verification and password reset.
OTP_TTL=15m

# §12.1: an exact-match allowlist. Never `*` outside development — the process
# refuses to start with a wildcard when NODE_ENV is not development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Cloudflare R2. Leave blank locally: media then degrades to placeholders
# (NFR-B-06) instead of breaking the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fi-media-dev
R2_BACKUP_PREFIX=backups/
MEDIA_URL_TTL_SECONDS=900

# NFR-S-06 / NFR-S-11
AUTH_RATE_LIMIT_PER_MIN=10
ADMIN_RATE_LIMIT_PER_MIN=30
GLOBAL_RATE_LIMIT_PER_MIN=300

# Resend (https://resend.com → API Keys). Leave blank locally: verification and
# password-reset endpoints still answer 202, nothing is delivered, and the log
# says so at boot. EMAIL_FROM must be on a domain verified with the provider —
# the default sandbox sender only delivers to the Resend account owner.
# Brevo (https://brevo.com -> Senders & IPs -> verify ONE address, no domain
# needed) or Resend (needs a verified domain). Brevo wins when both are set,
# because it is the one that can reach a real user without owning a domain.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Fitness Intellisense <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=8000

# Integration tests TRUNCATE every table in whatever database this names, so it
# must never be the same database as DATABASE_URL. Without it the integration
# suites skip and the unit tests still run.
TEST_DATABASE_URL=
